# syntax=docker/dockerfile:1
# -----------------------------------------------------------------------------
# KwikQuant Python Worker 镜像(回测子进程 + 实盘 Runner 长驻)。
# 构建(从 repo 根):
#   docker build -f docker/Dockerfile.worker -t kwikquant-worker:latest .
# 镜像名对齐 DockerWorkerManager.IMAGE = "kwikquant-worker:latest"。
# 运行:DockerWorkerManager docker run,env 注入 TASK_CONFIG_JSON/WORKER_SERVICE_TOKEN/
# KWIKQUANT_API_BASE/KWIKQUANT_WS_URL。dev:app 本地跑时 api-base-url 配
# host.docker.internal:8080(mac)/宿主 IP(linux);prod:app 容器在 kwikquant-worker-net。
# -----------------------------------------------------------------------------
FROM python:3.11-slim

# 非 root + curl(/health 探活用,WorkerOrchestratorService.healthCheck HTTP GET)
RUN apt-get update \
    && apt-get install -y --no-install-recommends curl \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --system kq && useradd --system --gid kq --no-create-home kq

WORKDIR /app

# 先装依赖(层缓存:requirements-worker.txt 已含 websockets,runner 长驻必需)
COPY requirements-worker.txt ./
RUN pip install --no-cache-dir --upgrade pip \
    && pip install --no-cache-dir -r requirements-worker.txt

# 拷 worker 代码(kwikquant SDK + kwikquant_worker 运行时)
COPY kwikquant/ ./kwikquant/
COPY kwikquant_worker/ ./kwikquant_worker/

# PYTHONPATH=/app 让 `python -m kwikquant_worker.worker_server` 能 import kwikquant + kwikquant_worker
ENV PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app

EXPOSE 8081

USER kq

# 默认 runner 模式(DockerWorkerManager 仅用于 runner;回测走 PythonSubprocessBacktestRunner 本地 python
# 不用镜像)。worker_server.main --mode required,故 CMD 显式传 runner,否则容器启动 argparse 报错 exit 2。
CMD ["python", "-m", "kwikquant_worker.worker_server", "--mode", "runner"]
