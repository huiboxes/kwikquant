# =============================================================================
# KwikQuant environment variables for local development.
#
# Copy this file to .env and fill in the values:
#   cp .env.example .env
#
# DO NOT commit the .env file to version control!
# =============================================================================

# PostgreSQL
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=kwikquant
POSTGRES_USER=kwikquant
POSTGRES_PASSWORD=your_secure_password_here

# Security secrets (REQUIRED — application will fail-fast at startup if missing)
# Generate with: openssl rand -base64 32
JWT_SECRET=REPLACE_WITH_openssl_rand_base64_32
ENCRYPTION_KEY=REPLACE_WITH_openssl_rand_base64_32
# MCP PAT HMAC pepper(任意高熵字符串,建议 ≥ 32 字节)
KWIKQUANT_MCP_PEPPER=REPLACE_WITH_random_high_entropy_string

# Spring profile。这是 prod 服务器 .env 模板,SPRING_PROFILES_ACTIVE=prod;
# 本地 dev 不要 cp 此文件(用 IDE 跑 application-dev,否则会误激活 prod profile)
SPRING_PROFILES_ACTIVE=prod

# (可选)回测子进程 python 解释器:app 镜像已内置 /opt/venv(docker/Dockerfile),
# application-prod.yaml 默认即它,无需设置;仅挂载自定义解释器时覆盖
# KWIKQUANT_WORKER_PYTHON=/opt/venv/bin/python

# (可选)worker 镜像 tag 锁定:server-deploy-image.sh 会自动 export
# KWIKQUANT_WORKER_IMAGE=ghcr.io/huiboxes/kwikquant-worker:$TAG 防 latest 错版;
# 手动设置则覆盖兜底 latest(docker-compose.prod.yml 经 ${...:-latest} 插值消费)
# KWIKQUANT_WORKER_IMAGE=ghcr.io/huiboxes/kwikquant-worker:latest
