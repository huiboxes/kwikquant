# =============================================================================
# KwikQuant environment variables for local development.
#
# Copy this file to .env and fill in the values:
#   cp .env.example .env
#
# DO NOT commit the .env file to version control!
# =============================================================================

# PostgreSQL
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=kwikquant
POSTGRES_USER=kwikquant
POSTGRES_PASSWORD=your_secure_password_here

# Security secrets (REQUIRED — application will fail-fast at startup if missing)
# Generate with: openssl rand -base64 32
JWT_SECRET=REPLACE_WITH_openssl_rand_base64_32
ENCRYPTION_KEY=REPLACE_WITH_openssl_rand_base64_32
# MCP PAT HMAC pepper(任意高熵字符串,建议 ≥ 32 字节)
KWIKQUANT_MCP_PEPPER=REPLACE_WITH_random_high_entropy_string

# Spring profile。这是 prod 服务器 .env 模板,SPRING_PROFILES_ACTIVE=prod;
# 本地 dev 不要 cp 此文件(用 IDE 跑 application-dev,否则会误激活 prod profile)
SPRING_PROFILES_ACTIVE=prod

# Worker python 解释器(prod 回测子进程;服务器建 venv:
#   python3.11 -m venv /opt/kwikquant/.venv-worker
#   /opt/kwikquant/.venv-worker/bin/pip install -r requirements-worker.txt
# 注意:prod 回测架构待 docker 化(留账),当前 app 容器是 JRE 无 python;回测走 dev/staging)
KWIKQUANT_WORKER_PYTHON=/opt/kwikquant/.venv-worker/bin/python